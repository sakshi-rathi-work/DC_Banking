# Distributed Banking System - Environment Configuration
# Default values used for local development and Docker Compose

# Host Port Mappings (configurable to avoid host conflicts)
FRONTEND_HOST_PORT=3000
GATEWAY_HOST_PORT=8080
NODE1_GRPC_HOST_PORT=50051
NODE2_GRPC_HOST_PORT=50052
NODE3_GRPC_HOST_PORT=50053
DB1_HOST_PORT=5441
DB2_HOST_PORT=5442
DB3_HOST_PORT=5443

# Security
JWT_SECRET=dev-dbs-jwt-secret-key-change-in-prod

# Lab Mode Flag
LAB_MODE=true

# Timing Constants (Milliseconds)
HEARTBEAT_INTERVAL_MS=1000
FAILURE_TIMEOUT_MS=3000
ELECTION_OK_TIMEOUT_MS=1500
COORDINATOR_WAIT_TIMEOUT_MS=3000
RING_HOP_TIMEOUT_MS=1000
RPC_DEADLINE_MS=2000
STRONG_ACK_TIMEOUT_MS=2000
CLOCK_SYNC_INTERVAL_MS=30000
BERKELEY_OUTLIER_MS=10000
LB_HEALTH_INTERVAL_MS=2000
PG_POOL_MAX=10
PG_LOCK_TIMEOUT_MS=3000
